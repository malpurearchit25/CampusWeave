digraph ER { graph [rankdir=LR, bgcolor="#ffffff", pad="0.35", nodesep="0.45",ranksep="0.85",splines=polyline]; node [shape=plain,fontname="Arial",fontsize=11]; edge [color="#6481a5",fontname="Arial",fontsize=9,arrowsize=.7];
"dw_cohort" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>dw_cohort</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">cohort_key [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">division_name ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">department_name ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">academic_year ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">semester ?</TD></TR></TABLE>>];
"dw_faculty" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>dw_faculty</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">faculty_key [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">faculty_name ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">department_name ?</TD></TR></TABLE>>];
"dw_period" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>dw_period</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">period_key [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">start_time ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">end_time ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">slot_type ?</TD></TR></TABLE>>];
"dw_subject" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>dw_subject</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">subject_key [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">course_code ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">course_name ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">subject_type ?</TD></TR></TABLE>>];
"dw_teaching_fact" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>dw_teaching_fact</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">source_entry_id [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">run_id</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">subject_key [FK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">faculty_key [FK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">cohort_key [FK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">period_key [FK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">day_of_week ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">teaching_hours</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">loaded_at ?</TD></TR></TABLE>>];
"dw_subject" -> "dw_teaching_fact" [taillabel="1",headlabel="0..N",label="subject_key"];
"dw_faculty" -> "dw_teaching_fact" [taillabel="1",headlabel="0..N",label="faculty_key"];
"dw_cohort" -> "dw_teaching_fact" [taillabel="1",headlabel="0..N",label="cohort_key"];
"dw_period" -> "dw_teaching_fact" [taillabel="1",headlabel="0..N",label="period_key"];
}
