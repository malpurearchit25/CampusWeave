digraph ER { graph [rankdir=LR, bgcolor="#ffffff", pad="0.35", nodesep="0.45",ranksep="0.85",splines=polyline]; node [shape=plain,fontname="Arial",fontsize=11]; edge [color="#6481a5",fontname="Arial",fontsize=9,arrowsize=.7];
"courses" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>courses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">course_id [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">course_code [UK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">course_name</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">department_id [FK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">subject_type</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">sessions_per_week</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">session_duration_slots</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">required_room_type ?</TD></TR></TABLE>>];
"departments" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>departments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">department_id [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">department_name [UK]</TD></TR></TABLE>>];
"divisions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>divisions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">division_id [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">division_name</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">department_id [FK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">academic_year</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">semester</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">student_count</TD></TR></TABLE>>];
"faculty" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>faculty</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">faculty_id [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">faculty_code [UK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">faculty_name</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">department_id [FK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">designation ?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">max_weekly_hours</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">user_id [FK,UK] ?</TD></TR></TABLE>>];
"faculty_courses" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>faculty_courses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">faculty_id [PK,FK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">course_id [PK,FK]</TD></TR></TABLE>>];
"faculty_unavailability" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>faculty_unavailability</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">unavailability_id [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">faculty_id [FK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">day_of_week</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">slot_id [FK]</TD></TR></TABLE>>];
"rooms" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>rooms</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">room_id [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">room_code [UK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">room_name</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">room_type</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">capacity</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">is_active</TD></TR></TABLE>>];
"time_slots" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>time_slots</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">slot_id [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">start_time [UK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">end_time [UK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">slot_type</TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c6d4e5"><TR><TD BGCOLOR="#193b65"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">user_id [PK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">username [UK]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">password_hash</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">role</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f4f7fc">is_active</TD></TR></TABLE>>];
"departments" -> "courses" [taillabel="1",headlabel="0..N",label="department_id"];
"departments" -> "divisions" [taillabel="1",headlabel="0..N",label="department_id"];
"departments" -> "faculty" [taillabel="1",headlabel="0..N",label="department_id"];
"users" -> "faculty" [taillabel="0..1",headlabel="0..1",label="user_id"];
"faculty" -> "faculty_courses" [taillabel="1",headlabel="0..N",label="faculty_id"];
"courses" -> "faculty_courses" [taillabel="1",headlabel="0..N",label="course_id"];
"faculty" -> "faculty_unavailability" [taillabel="1",headlabel="0..N",label="faculty_id"];
"time_slots" -> "faculty_unavailability" [taillabel="1",headlabel="0..N",label="slot_id"];
}
